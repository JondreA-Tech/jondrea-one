# =============================================================================
# Jondrea One — plantilla de entorno
# =============================================================================
# cp .env.example .env
#
# Producción (Vercel / Render): definir las mismas keys en el dashboard.
# No subas .env al repo.
# =============================================================================

# Credenciales del panel /admin (login cookie).
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# API CareMe (Nest) — sin sufijo /v1
# Local:  http://localhost:3001
# Beta:   https://careme-api-ftob.onrender.com
CAREME_API_URL=http://localhost:3001

# Debe coincidir con ADMIN_ANALYTICS_KEY en Render (CareMe API).
CAREME_ADMIN_ANALYTICS_KEY=dev-admin-analytics-key

# API Nido (Nest) — sin sufijo /v1
# Local:  http://localhost:3002
NIDO_API_URL=http://localhost:3002

# Debe coincidir con ADMIN_ANALYTICS_KEY en la API de Nido.
NIDO_ADMIN_ANALYTICS_KEY=dev-nido-admin-analytics-key

# APKs públicas. Si no hay URL, el sitio busca el archivo en public/downloads/.
# Los .apk están en .gitignore: copialos localmente o usá una URL (EAS / GitHub).
# Si no hay archivo ni URL, la ficha muestra “APK próxima semana”.
# NEXT_PUBLIC_CAREME_APK_URL=/downloads/careme.apk
# NEXT_PUBLIC_NIDO_APK_URL=/downloads/nido.apk
