# =============================================================================
# Jondrea One — plantilla de entorno
# =============================================================================
# cp .env.example .env
#
# Producción (Vercel / Render): definir las mismas keys en el dashboard.
# No subas .env al repo.
# =============================================================================

# Credenciales del panel /admin (login cookie).
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# API Nido (Nest) — sin sufijo /v1
# Local:  http://localhost:3002
# Render (plan free se duerme; el panel pega a /v1/health al abrir):
# NIDO_API_URL=https://nido-api-9ccn.onrender.com
NIDO_API_URL=http://localhost:3002

# Debe coincidir con ADMIN_ANALYTICS_KEY en la API de Nido.
NIDO_ADMIN_ANALYTICS_KEY=dev-nido-admin-analytics-key

# APKs públicas. Si no hay URL, el sitio usa nidoRelease.publishedApkUrl
# o el archivo en public/downloads/nido.apk.
# Los .apk están en .gitignore: no se commitean (pesan ~70 MB).
# NEXT_PUBLIC_NIDO_APK_URL=https://expo.dev/artifacts/eas/...apk
